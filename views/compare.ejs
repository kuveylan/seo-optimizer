<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rakip SEO Karşılaştırma | SEO Optimizer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
    <nav class="top-nav">
        <div class="nav-inner">
            <a href="/" class="brand"><span class="brand-icon">🔍</span><span class="brand-name">SEO Optimizer</span></a>
            <div class="nav-menu">
                <a href="/compare" class="nav-cta">⚔️ Rakip Karşılaştırma</a>
                <a href="/tools">🛠️ Araçlar</a>
                <a href="/">Ana Sayfa</a>
            </div>
        </div>
    </nav>

    <main class="result-page">
        <div class="result-container">
            <div style="text-align: center; margin-bottom: 40px;">
                <h1 style="font-size: 36px; font-weight: 900; color: var(--slate-900); margin-bottom: 8px;">⚔️ Rakip SEO Karşılaştırması</h1>
                <p style="color: var(--slate-500); font-size: 17px;">Kendi siteniz ile rakibinizin SEO skorlarını yan yana inceleyin.</p>
            </div>

            <div class="audit-card" style="max-width: 760px; margin-bottom: 40px;">
                <form action="/compare" method="POST">
                    <div class="form-group">
                        <label for="siteA">Site A (Sizin / Ana Siteniz)</label>
                        <input type="url" id="siteA" name="siteA" required placeholder="https://sizin-site.com" class="form-input">
                    </div>
                    <div class="form-group">
                        <label for="siteB">Site B (Rakip)</label>
                        <input type="url" id="siteB" name="siteB" required placeholder="https://rakip-site.com" class="form-input">
                    </div>
                    <button type="submit" class="btn-primary">⚔️ Siteleri Karşılaştır</button>
                </form>
                <% if (error) { %>
                    <div style="background: var(--red-100); color: var(--red-700); padding: 14px; border-radius: 10px; margin-top: 16px; font-size: 14px;"><%= error %></div>
                <% } %>
            </div>

            <% if (result) { %>
                <% const A = result.sites.A; const B = result.sites.B; %>
                <% const winText = result.winner === 'A' ? '🟢 Site A önde' : result.winner === 'B' ? '🔵 Site B önde' : '⚪ Berabere'; %>

                <!-- SONUÇ ÖZETİ -->
                <div class="score-hero" style="justify-content: center; text-align: center;">
                    <div>
                        <span class="score-label">Karşılaştırma Sonucu</span>
                        <h2><%= winText %></h2>
                        <p>Site A: <b><%= A.score ? A.score.overall : '—' %></b>/100 &nbsp;vs&nbsp; Site B: <b><%= B.score ? B.score.overall : '—' %></b>/100</p>
                    </div>
                </div>

                <!-- SKOR TABLOSU -->
                <div class="card" style="background: white; border-radius: 16px; padding: 32px; border: 1px solid var(--slate-200); margin-bottom: 32px;">
                    <h2 style="font-size: 20px; font-weight: 800; margin-bottom: 20px;">📊 Kategori Bazlı Skor Karşılaştırması</h2>
                    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                        <thead>
                            <tr style="background: var(--slate-50);">
                                <th style="padding: 12px; text-align: left; color: var(--slate-500);">Kategori</th>
                                <th style="padding: 12px; text-align: center; color: var(--slate-500);">Site A</th>
                                <th style="padding: 12px; text-align: center; color: var(--slate-500);"></th>
                                <th style="padding: 12px; text-align: center; color: var(--slate-500);">Site B</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% const cats = [['overall','Genel'],['performance','Performans'],['seo','SEO'],['accessibility','Erişilebilirlik'],['bestPractices','Best Practices'],['security','Güvenlik']]; %>
                            <% cats.forEach(([key, name]) => {
                                const va = A.score ? A.score[key] : 0;
                                const vb = B.score ? B.score[key] : 0;
                                const colorA = va > vb ? '#10b981' : va < vb ? '#ef4444' : '#64748b';
                                const colorB = vb > va ? '#10b981' : vb < va ? '#ef4444' : '#64748b';
                            %>
                            <tr style="border-bottom: 1px solid var(--slate-100);">
                                <td style="padding: 12px; font-weight: 600;"><%= name %></td>
                                <td style="padding: 12px; text-align: center; font-weight: 800; color: <%- colorA %>;"><%= va %></td>
                                <td style="padding: 12px; text-align: center; font-size: 16px;"><%= va > vb ? '▶' : va < vb ? '◀' : '=' %></td>
                                <td style="padding: 12px; text-align: center; font-weight: 800; color: <%- colorB %>;"><%= vb %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- SİTE METRİKLERİ -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
                    <% [['A', A], ['B', B]].forEach(([tag, S]) => { %>
                    <div class="card" style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--slate-200);">
                        <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 12px; color: <%= tag === 'A' ? '#10b981' : '#6366f1' %>;"><%= tag === 'A' ? '🟢' : '🔵' %> Site <%= tag %></h3>
                        <p style="font-size: 12px; color: var(--slate-500); margin-bottom: 16px; word-break: break-all;"><%= S.url %></p>
                        <table style="width: 100%; font-size: 13px; border-collapse: collapse;">
                            <tr><td style="padding: 6px 0; color: var(--slate-500);">Taranan Sayfa</td><td style="padding: 6px 0; text-align: right; font-weight: 700;"><%= S.crawl.pages %></td></tr>
                            <tr><td style="padding: 6px 0; color: var(--slate-500);">Ortalama Yanıt</td><td style="padding: 6px 0; text-align: right; font-weight: 700;"><%= S.crawl.avgResponseMs %>ms</td></tr>
                            <tr><td style="padding: 6px 0; color: var(--slate-500);">Kırık Link</td><td style="padding: 6px 0; text-align: right; font-weight: 700; color: <%= S.crawl.brokenLinks > 0 ? '#dc2626' : '#10b981' %>;"><%= S.crawl.brokenLinks %></td></tr>
                            <tr><td style="padding: 6px 0; color: var(--slate-500);">İç Link</td><td style="padding: 6px 0; text-align: right; font-weight: 700;"><%= S.crawl.internalLinks %></td></tr>
                            <tr><td style="padding: 6px 0; color: var(--slate-500);">Dış Link</td><td style="padding: 6px 0; text-align: right; font-weight: 700;"><%= S.crawl.externalLinks %></td></tr>
                            <tr><td style="padding: 6px 0; color: var(--slate-500);">Kelime Sayısı</td><td style="padding: 6px 0; text-align: right; font-weight: 700;"><%= S.content.wordCount || '—' %></td></tr>
                            <tr><td style="padding: 6px 0; color: var(--slate-500);">Schema.org</td><td style="padding: 6px 0; text-align: right; font-weight: 700; color: <%= S.content.schemaOrgCount > 0 ? '#10b981' : '#d97706' %>;"><%= S.content.schemaOrgCount > 0 ? '✓' : '✗' %></td></tr>
                            <tr><td style="padding: 6px 0; color: var(--slate-500);">Tespit Edilen Sorun</td><td style="padding: 6px 0; text-align: right; font-weight: 700; color: <%= S.issuesCount > 0 ? '#d97706' : '#10b981' %>;"><%= S.issuesCount %></td></tr>
                        </table>
                        <div style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--slate-100);">
                            <span style="font-size: 12px; font-weight: 700; color: var(--slate-500);">En Güçlü Anahtar Kelimeler</span>
                            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;">
                                <% (S.keywords || []).slice(0, 5).forEach(k => { %>
                                    <span style="background: var(--indigo-50); color: var(--indigo-600); font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 50px;"><%= k.word %></span>
                                <% }); %>
                                <% if (!S.keywords || S.keywords.length === 0) { %><span style="font-size: 12px; color: var(--slate-400);">Veri yok</span><% } %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>

                <!-- KAZANANIN ÜSTÜN OLDUĞU ALANLAR -->
                <% if (result.differences.length > 0) { %>
                <div class="card" style="background: white; border-radius: 16px; padding: 32px; border: 1px solid var(--slate-200); margin-bottom: 40px;">
                    <h2 style="font-size: 20px; font-weight: 800; margin-bottom: 16px;">🏆 Öne Çıkan Farklar</h2>
                    <% result.differences.forEach(d => {
                        const nameMap = { performance: 'Performans', seo: 'SEO', accessibility: 'Erişilebilirlik', bestPractices: 'Best Practices', security: 'Güvenlik' };
                    %>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--slate-100);">
                        <div style="font-weight: 600;"><%= nameMap[d.category] || d.category %></div>
                        <div style="font-size: 14px;">
                            <span style="font-weight: 800; color: <%= d.siteA > d.siteB ? '#10b981' : '#64748b' %>;"><%= d.siteA %></span>
                            <span style="color: var(--slate-400);"> vs </span>
                            <span style="font-weight: 800; color: <%= d.siteB > d.siteA ? '#10b981' : '#64748b' %>;"><%= d.siteB %></span>
                            <span style="margin-left: 8px; font-weight: 700; font-size: 12px; color: <%= d.advantage === 'A' ? '#10b981' : '#6366f1' %>;">
                                <%= d.advantage === 'A' ? '→ A üstün' : '→ B üstün' %>
                            </span>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } %>
            <% } %>
        </div>
    </main>
</body>
</html>
