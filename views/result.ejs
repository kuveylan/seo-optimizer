<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>SEO Denetim ve Analiz Raporu | <%= targetUrl %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>

    <!-- ÜST MENÜ -->
    <nav class="top-nav">
        <div class="nav-inner">
            <a href="/" class="brand">
                <span class="brand-icon">🔍</span>
                <span class="brand-name">SEO Optimizer</span>
            </a>
            <div class="nav-menu">
                <a href="/download-pdf?url=<%= encodeURIComponent(targetUrl) %>" class="btn-download" style="padding: 8px 16px; font-size: 14px;">
                    📥 PDF İndir
                </a>
                <a href="/" class="btn-secondary" style="padding: 8px 16px;">Yeni Analiz</a>
            </div>
        </div>
    </nav>

    <main class="result-page">
        <div class="result-container">

            <!-- BAŞLIK & PDF BUTONU -->
            <div class="result-header">
                <div>
                    <span style="font-size: 12px; font-weight: 700; color: var(--indigo-600); text-transform: uppercase;">Kurumsal SEO Denetimi</span>
                    <h1>📊 Analiz Sonuç Raporu</h1>
                    <p class="meta">Hedef: <b><%= targetUrl %></b> <% if (userEmail) { %>• Rapor Alıcısı: <b><%= userEmail %></b><% } %> • Taranan Sayfa: <b><%= scanData.totalPagesScanned %></b></p>
                </div>
                <div>
                    <a href="/download-pdf?url=<%= encodeURIComponent(targetUrl) %>" class="btn-download">
                        📥 Profesyonel PDF Raporu İndir
                    </a>
                </div>
            </div>

            <!-- SKOR HERO -->
            <% if (scored) { %>
            <div class="score-hero">
                <div>
                    <span class="score-label">Lighthouse Standart Puanı</span>
                    <h2>Genel SEO ve Sağlık Skoru</h2>
                    <p>Sitenizin arama motorlarındaki performans, hız, güvenlik ve uyumluluk skoru. Aşağıda puanınızın kırılmasına neden olan tüm eksiklikleri ve çözüm adımlarını bulabilirsiniz.</p>
                </div>
                <div class="score-circle" style="border-color: <%= scored.labels.overall.color === 'green' ? '#10b981' : scored.labels.overall.color === 'yellow' ? '#f59e0b' : '#ef4444' %>;">
                    <span class="score-num"><%= scored.scores.overall %></span>
                    <span class="score-total">/ 100</span>
                </div>
            </div>

            <!-- KATEGORİ SKORLARI GRİDİ -->
            <div class="score-grid">
                <%
                const catNames = { performance: 'Performance', seo: 'SEO', accessibility: 'Erişilebilirlik', bestPractices: 'Best Practices' };
                ['performance', 'seo', 'accessibility', 'bestPractices'].forEach(key => {
                    const s = scored.scores[key];
                    const l = scored.labels[key];
                    const statusCls = l.color === 'green' ? 'status-green' : l.color === 'yellow' ? 'status-yellow' : 'status-red';
                %>
                <div class="score-item">
                    <div class="score-val" style="color: <%= l.color === 'green' ? '#10b981' : l.color === 'yellow' ? '#d97706' : '#dc2626' %>;"><%= s %></div>
                    <div class="score-name"><%= catNames[key] %></div>
                    <span class="score-status <%= statusCls %>"><%= l.emoji %> <%= l.label %></span>
                </div>
                <% }); %>
            </div>
            <% } %>

            <!-- SERP ÖNİZLEME (Google Arama Sonucu Görünümü) -->
            <% const mainPage = scanData.pages[0]; %>
            <% const serpTitle = mainPage && mainPage.title ? mainPage.title.text : (targetUrl); %>
            <% const serpDesc = mainPage && mainPage.description ? mainPage.description.text : 'Meta açıklaması bulunamadı.'; %>
            <% const serpUrl = (targetUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')); %>
            <div class="card" style="background: white; border-radius: 16px; padding: 32px; border: 1px solid var(--slate-200); margin-bottom: 32px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                    <h2 style="font-size: 20px; font-weight: 800; margin: 0;">🔍 Google Arama Sonucu Önizlemesi (SERP)</h2>
                    <span style="background: var(--indigo-50); color: var(--indigo-600); font-weight: 700; font-size: 12px; padding: 4px 12px; border-radius: 50px;">Nasıl Görünüyorsunuz?</span>
                </div>
                <!-- Google SERP Simülasyonu -->
                <div style="background: white; border: 1px solid var(--slate-200); border-radius: 12px; padding: 24px; max-width: 600px;">
                    <div style="font-size: 13px; color: var(--slate-500); display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">
                        <span style="width: 18px; height: 18px; border-radius: 50%; background: var(--slate-200); display: inline-flex; align-items: center; justify-content: center; font-size: 10px;">🔎</span>
                        <%= serpUrl %>
                    </div>
                    <a href="<%= targetUrl %>" target="_blank" rel="noopener" style="font-size: 20px; color: #1a0dab; text-decoration: none; font-weight: 400; line-height: 1.3; display: block; cursor: pointer;">
                        <%= serpTitle.length > 63 ? serpTitle.substring(0, 63) + '...' : serpTitle %>
                    </a>
                    <p style="font-size: 14px; color: #4d5156; margin-top: 8px; line-height: 1.5;">
                        <%= serpDesc.length > 160 ? serpDesc.substring(0, 160) + '...' : serpDesc %>
                    </p>
                </div>
                <div style="margin-top: 16px; font-size: 13px; color: var(--slate-500);">
                    <% if (mainPage && mainPage.title && mainPage.title.length > 60) { %>
                        ⚠️ Title <b><%= mainPage.title.length %></b> karakter — 60 karakteri aşıyor, Google keser. <a href="/tools?tool=meta" style="color: var(--indigo-600); font-weight: 600;">Meta etiket üretici ile düzeltin →</a>
                    <% } else if (mainPage && mainPage.description && mainPage.description.length > 160) { %>
                        ⚠️ Meta Description <b><%= mainPage.description.length %></b> karakter — 160 karakteri aşıyor, kesilebilir. <a href="/tools?tool=meta" style="color: var(--indigo-600); font-weight: 600;">Meta etiket üretici ile düzeltin →</a>
                    <% } else { %>
                        ✅ Title ve Meta Description uzunlukları Google standartlarına uygun.
                    <% } %>
                </div>
            </div>

            <!-- PUAN KAYBI NEDENLERİ (EKSİKLİKLER) -->
            <div class="issues-section">
                <div class="issues-header">
                    <h2>⚠️ Puan Kaybına Neden Olan Eksiklikler</h2>
                    <span class="issues-count"><%= issues.length %> Sorun Tespit Edildi</span>
                </div>
                <p style="color: var(--slate-500); font-size: 15px; margin-bottom: 24px;">Müşterinize sunacağınız raporda yer alan ve sitenin 100 tam puan almasını engelleyen tüm kritik ve orta düzey eksiklikler:</p>

                <% if (issues && issues.length > 0) { %>
                    <% issues.forEach((iss, idx) => {
                        const sevCls = iss.severity === 'Kritik' ? 'sev-critical' : iss.severity === 'Orta' ? 'sev-medium' : 'sev-low';
                        const badgeCls = iss.severity === 'Kritik' ? 'critical' : iss.severity === 'Orta' ? 'medium' : 'low';
                    %>
                    <div class="issue-card <%= sevCls %>">
                        <div class="issue-head">
                            <div class="issue-meta">
                                <span class="issue-num">#<%= idx + 1 %></span>
                                <span class="issue-cat"><%= iss.category %></span>
                                <span class="issue-title"><%= iss.title %></span>
                            </div>
                            <span class="sev-badge <%= badgeCls %>"><%= iss.severity %></span>
                        </div>
                        <p class="issue-detail"><strong>Neden Önemli:</strong> <%= iss.detail %></p>
                        <div class="fix-box">
                            <span class="fix-label">🛠️ Çözüm / Düzeltme Adımı:</span>
                            <p><%= iss.fix %></p>
                        </div>
                        <% if (iss.pages && iss.pages.length > 0) { %>
                        <div class="affected-pages">
                            <strong>Etkilenen Sayfalar (<%= iss.pageCount %>):</strong>
                            <code><%= iss.pages[0] %></code>
                            <% if (iss.pageCount > 1) { %> ve <%= iss.pageCount - 1 %> sayfa daha<% } %>
                        </div>
                        <% } %>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="no-issues">
                        🎉 Tebrikler! Sitenizde puan kaybettirecek herhangi bir eksiklik veya sorun bulunamadı.
                    </div>
                <% } %>
            </div>

            <!-- LINK SAĞLIĞI & İÇERİK İSTATİSTİKLERİ -->
            <% const mainLink = scanData.pages[0] ? scanData.pages[0].linkHealth : null; %>
            <% const mainContent = scanData.pages[0] ? scanData.pages[0].content : null; %>
            <div class="audit-card" style="max-width: none; padding: 40px; margin-bottom: 40px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--slate-200);">
                    <h2 style="font-size: 22px; font-weight: 800; margin: 0;">🔗 Link Sağlığı & İçerik Analizi</h2>
                    <span style="background: var(--indigo-50); color: var(--indigo-600); font-weight: 700; font-size: 12px; padding: 4px 12px; border-radius: 50px;">Gerçek Kontroller</span>
                </div>

                <div class="score-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 24px;">
                    <% if (crawlData.linkHealth) { %>
                    <div class="score-item">
                        <div class="score-val" style="color: <%= crawlData.linkHealth.totalBrokenLinks > 0 ? '#dc2626' : '#10b981' %>;"><%= crawlData.linkHealth.totalBrokenLinks %></div>
                        <div class="score-name">Kırık Link</div>
                        <span class="score-status <%= crawlData.linkHealth.totalBrokenLinks > 0 ? 'status-red' : 'status-green' %>"><%= crawlData.linkHealth.totalBrokenLinks > 0 ? '🔴 Tespit Edildi' : '✅ Temiz' %></span>
                    </div>
                    <div class="score-item">
                        <div class="score-val" style="color: #10b981;"><%= crawlData.linkHealth.totalInternalLinks %></div>
                        <div class="score-name">İç Link</div>
                        <span class="score-status status-green">✅ Yapı</span>
                    </div>
                    <div class="score-item">
                        <div class="score-val" style="color: #6366f1;"><%= crawlData.linkHealth.totalExternalLinks %></div>
                        <div class="score-name">Dış Link</div>
                        <span class="score-status status-green">✅ Bağlantı</span>
                    </div>
                    <div class="score-item">
                        <div class="score-val" style="color: #d97706;"><%= crawlData.linkHealth.totalChecked %></div>
                        <div class="score-name">Kontrol Edilen</div>
                        <span class="score-status status-yellow">🔍 Doğrulandı</span>
                    </div>
                    <% } %>
                </div>

                <% if (mainContent) { %>
                <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: 12px; padding: 20px;">
                    <div style="font-weight: 700; color: var(--slate-800); margin-bottom: 12px;">📝 İçerik Durumu (Ana Sayfa)</div>
                    <div class="score-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 0;">
                        <div class="score-item">
                            <div class="score-val" style="color: <%= mainContent.wordCount >= 200 ? '#10b981' : '#d97706' %>;"><%= mainContent.wordCount %></div>
                            <div class="score-name">Kelime Sayısı</div>
                            <span class="score-status <%= mainContent.wordCount >= 200 ? 'status-green' : 'status-yellow' %>"><%= mainContent.wordCount >= 200 ? '✅ Yeterli' : '🟡 Zayıf' %></span>
                        </div>
                        <div class="score-item">
                            <div class="score-val" style="color: <%= mainContent.schemaOrgCount > 0 ? '#10b981' : '#d97706' %>;"><%= mainContent.schemaOrgCount %></div>
                            <div class="score-name">Schema.org</div>
                            <span class="score-status <%= mainContent.schemaOrgCount > 0 ? 'status-green' : 'status-yellow' %>"><%= mainContent.schemaOrgCount > 0 ? '✅ Var' : '🟡 Yok' %></span>
                        </div>
                        <div class="score-item">
                            <div class="score-val" style="color: <%= mainContent.hasAnalytics ? '#10b981' : '#d97706' %>;"><%= mainContent.hasAnalytics ? '✓' : '✗' %></div>
                            <div class="score-name">Analiz Aracı</div>
                            <span class="score-status <%= mainContent.hasAnalytics ? 'status-green' : 'status-yellow' %>"><%= mainContent.hasAnalytics ? '✅ Var' : '🟡 Yok' %></span>
                        </div>
                    </div>
                    <% if (mainContent.schemaTypes && mainContent.schemaTypes.length > 0) { %>
                    <div style="margin-top: 12px; font-size: 13px; color: var(--slate-600);">
                        <strong>Schema Türleri:</strong>
                        <% mainContent.schemaTypes.forEach(t => { %>
                            <code style="background: var(--indigo-50); color: var(--indigo-600); padding: 2px 8px; border-radius: 4px; font-size: 12px; margin-right: 4px;"><%= t %></code>
                        <% }); %>
                    </div>
                    <% } %>
                </div>
                <% } %>
            </div>

            <!-- AI UZMAN RAPORU -->
            <div class="audit-card" style="max-width: none; padding: 40px; margin-bottom: 40px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--slate-200);">
                    <h2 style="font-size: 22px; font-weight: 800; margin: 0;">🤖 Yapay Zeka Uzman Raporu & Strateji</h2>
                    <span style="background: var(--indigo-50); color: var(--indigo-600); font-weight: 700; font-size: 12px; padding: 4px 12px; border-radius: 50px;">Claude AI</span>
                </div>
                <div id="markdown-content" class="prose" style="font-size: 15px; line-height: 1.8; color: var(--slate-700);"></div>
            </div>

            <!-- ALT PDF İNDİR BANNER -->
            <div style="background: linear-gradient(135deg, var(--slate-900), var(--indigo-900)); border-radius: 20px; padding: 48px; text-align: center; color: white;">
                <h2 style="font-size: 28px; font-weight: 800; margin-bottom: 12px;">Bu Raporu Müşterinize Sunmaya Hazır Mısınız?</h2>
                <p style="color: #cbd5e1; font-size: 16px; max-width: 600px; margin: 0 auto 32px; line-height: 1.6;">Kurumsal kapaklı, tüm eksiklikleri ve çözüm adımlarını içeren şık PDF raporunu hemen indirebilir ve müşterinize sunabilirsiniz.</p>
                <a href="/download-pdf?url=<%= encodeURIComponent(targetUrl) %>" class="btn-download" style="background: var(--emerald-500); padding: 16px 32px; font-size: 16px;">
                    📥 Profesyonel PDF Raporunu İndir
                </a>
            </div>

            <!-- E-POSTA İLE RAPOR GÖNDERİMİ (yalnızca SMTP yapılandırılmışsa) -->
            <% if (emailConfigured) { %>
            <div class="card" style="background: white; border-radius: 16px; padding: 32px; border: 1px solid var(--slate-200); margin-bottom: 40px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                    <h2 style="font-size: 20px; font-weight: 800; margin: 0;">📧 Raporu E-Posta ile Gönder</h2>
                    <span id="email-status" style="font-size: 13px; font-weight: 600;"></span>
                </div>
                <p style="color: var(--slate-500); font-size: 14px; margin-bottom: 20px;">Bu raporu müşterinizin veya kendi e-posta adresinize PDF eki olarak gönderin.</p>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <input type="email" id="report-email" value="<%= userEmail %>" placeholder="rapor@gonderilecek.com"
                        style="flex: 1; min-width: 250px; padding: 12px 16px; border: 2px solid var(--slate-200); border-radius: 10px; font-size: 14px;">
                    <button onclick="sendReport()" class="btn-download" style="background: var(--indigo-600); border: none; cursor: pointer; padding: 12px 24px;">
                        📧 Raporu Gönder
                    </button>
                </div>
            </div>
            <% } %>

        </div>
    </main>

    <script>
        const rawMarkdown = <%- JSON.stringify(aiReport || '') %>;
        document.getElementById('markdown-content').innerHTML = marked.parse(rawMarkdown);

        async function sendReport() {
            const email = document.getElementById('report-email').value.trim();
            const statusEl = document.getElementById('email-status');
            if (!email) { statusEl.textContent = '❌ Lütfen e-posta adresi girin.'; statusEl.style.color = '#dc2626'; return; }

            statusEl.textContent = '⏳ Gönderiliyor...'; statusEl.style.color = '#d97706';
            try {
                const res = await fetch('/send-report', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url: '<%= targetUrl %>', email })
                });
                const data = await res.json();
                if (data.success) {
                    statusEl.textContent = '✅ ' + data.message; statusEl.style.color = '#059669';
                } else {
                    statusEl.textContent = '⚠️ ' + (data.message || data.error || 'Gönderilemedi'); statusEl.style.color = '#d97706';
                }
            } catch (e) {
                statusEl.textContent = '❌ Hata: ' + e.message; statusEl.style.color = '#dc2626';
            }
        }
    </script>
</body>
</html>
