# ─────────────────────────────────────
# AI RAPORU AYARLARI
# ─────────────────────────────────────
# Seçenek 1: Doğrudan Anthropic Claude API kullan
#   https://console.anthropic.com/settings/keys adresinden anahtar alın
ANTHROPIC_API_KEY=your_api_key_here

# Seçenek 2: 9routers gibi lokal proxy kullan (aşağıdaki gibi)
#   https://github.com/9routers — Claude/OpenAI modellerini lokal çalıştırır
# AI_API_URL=http://localhost:20128/v1

# Kullanılacak AI modeli (varsayılan: claude-sonnet-4-5)
#   Anthropic:  claude-sonnet-4-5 | claude-opus-4
#   Proxy:      mycombo | gpt-4o | claude-sonnet-4-5
AI_MODEL=mycombo

# E-posta (SMTP) - Rapor Gönderimi için
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
